+namespace {
+bool sameParagraph(const PinyinTransimeParagraphSnapshotV2 &a,
+                   const PinyinTransimeParagraphSnapshotV2 &b) {
+    return a.apiVersion == 2 && b.apiVersion == 2 && a.hold && b.hold &&
+           a.hasDraft == b.hasDraft && a.ready == b.ready &&
+           a.fullySelected == b.fullySelected && a.draftId == b.draftId &&
+           a.revision == b.revision && a.activeSegment == b.activeSegment &&
+           a.cursorBytes == b.cursorBytes && a.pageIndex == b.pageIndex &&
+           a.source == b.source && a.rawInput == b.rawInput &&
+           (a.activeCandidate.ready ? transimeSameSnapshot(a.activeCandidate, b.activeCandidate)
+                                    : !b.activeCandidate.ready);
+}
+size_t previousUtf8(const std::string &text, size_t offset) {
+    if (!offset) return 0;
+    --offset;
+    while (offset && (static_cast<unsigned char>(text[offset]) & 0xc0) == 0x80) --offset;
+    return offset;
+}
+size_t nextUtf8(const std::string &text, size_t offset) {
+    if (offset >= text.size()) return text.size();
+    ++offset;
+    while (offset < text.size() && (static_cast<unsigned char>(text[offset]) & 0xc0) == 0x80) ++offset;
+    return offset;
+}
