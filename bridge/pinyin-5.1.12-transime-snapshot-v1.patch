+bool PinyinEngine::transimeSetCommentV1(InputContext *inputContext, int pageIndex,
+                                       PinyinTransimeSnapshotV1 expected,
+                                       std::string translation) const {
+    if (!inputContext || pageIndex < 0 || !transimeCommentIsSafe(translation)) {
+        return false;
+    }
+    auto *state = inputContext->propertyFor(&factory_);
+    auto &annotations = state->transimeComments_;
+    // No candidate-list traversal: visit at most ten already annotated objects.
+    std::erase_if(annotations, [](const auto &weak) {
+        const auto handle = weak.lock();
+        return !handle || !handle->candidate ||
+               !handle->candidate->transimeCommentSnapshot();
+    });
+    if (translation.empty()) {
+        for (auto iter = annotations.begin(); iter != annotations.end(); ++iter) {
+            const auto handle = iter->lock();
+            auto *saved = handle ? handle->candidate : nullptr;
+            if (saved && handle->pageIndex == pageIndex &&
+                saved->engine_ == this && saved->inputContext_ == inputContext &&
+                transimeSameSnapshot(expected, *saved->transimeCommentSnapshot())) {
+                // Restore the same still-live object even if a mouse click
+                // already changed pages before the Module observed UpdateUI.
+                saved->setTransimeComment(pageIndex, expected, {});
+                annotations.erase(iter);
+                return true;
+            }
+        }
+    }
+    const auto candidateList = inputContext->inputPanel().candidateList();
+    if (!candidateList || pageIndex >= candidateList->size()) {
+        return false;
+    }
+    const auto *candidate = dynamic_cast<const PinyinCandidateWord *>(
+        &candidateList->candidate(pageIndex));
+    if (!candidate || candidate->engine_ != this ||
+        candidate->inputContext_ != inputContext) {
+        return false;
+    }
+    const auto actual = transimeSnapshotAtV1(inputContext, pageIndex);
+    if (!transimeSameSnapshot(expected, actual)) {
+        return false;
+    }
+    if (translation.empty()) {
+        // An unannotated current candidate supports a harmless capability probe.
+        // Never clear an annotation using a different generation's snapshot.
+        return !candidate->transimeCommentSnapshot();
+    }
+    const bool registered = std::any_of(annotations.begin(), annotations.end(),
+        [candidate](const auto &weak) {
+            const auto handle = weak.lock();
+            return handle && handle->candidate == candidate;
+        });
+    if (!registered && annotations.size() >= 10) {
+        return false;
+    }
+    // CandidateList exposes a const reference, but the pinyin-owned candidate
+    // object itself is mutable. Never cast external or special candidate types.
+    const_cast<PinyinCandidateWord *>(candidate)->setTransimeComment(
+        pageIndex, expected, std::move(translation));
+    if (!registered) {
+        annotations.push_back(candidate->transimeCommentHandle());
+    }
+    return true;
+}
