+bool transimeCommentIsSafe(const std::string &text) {
+    if (text.size() > 4096) {
+        return false;
+    }
+    if (text.empty()) {
+        return true; // Restore the saved comment, not a new translation.
+    }
+    if (utf8::lengthValidated(text) == utf8::INVALID_LENGTH) {
+        return false;
+    }
+    for (auto iter = text.begin(); iter != text.end();) {
+        uint32_t codepoint = 0;
+        iter = utf8::getNextChar(iter, text.end(), &codepoint);
+        // Keep annotations on one line and reject control/bidi/zero-width
+        // instructions. The caller additionally validates translation policy.
+        if (codepoint <= 0x1f || (codepoint >= 0x7f && codepoint <= 0x9f) ||
+            codepoint == 0x061c ||
+            (codepoint >= 0x200b && codepoint <= 0x200f) ||
+            (codepoint >= 0x2028 && codepoint <= 0x202e) ||
+            (codepoint >= 0x2060 && codepoint <= 0x206f) || codepoint == 0xfeff) {
+            return false;
+        }
+    }
+    return true;
+}
 
