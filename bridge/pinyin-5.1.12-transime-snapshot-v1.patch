+bool PinyinEngine::paragraphSelectCurrent(InputContext *ic) {
+    auto *state = ic->propertyFor(&factory_);
+    auto &context = state->context();
+    if (context.empty() || context.selected()) return true;
+    const auto list = ic->inputPanel().candidateList();
+    if (list && list->cursorIndex() >= 0) {
+        // This is a real selection; the native candidate implements custom and
+        // ordinary selection without rebuilding an external selection stack.
+        const auto &candidate = list->candidate(list->cursorIndex());
+        const auto *pinyin = dynamic_cast<const PinyinCandidateWord *>(&candidate);
+        if (pinyin && pinyin->engine_ == this && pinyin->inputContext_ == ic) {
+            const auto &candidates = context.candidatesToCursor();
+            if (pinyin->idx_ < candidates.size()) context.selectCandidatesToCursor(pinyin->idx_);
+        } else if (dynamic_cast<const CustomPhraseCandidateWord *>(&candidate) ||
+                   dynamic_cast<const LuaCandidateWord *>(&candidate) ||
+                   dynamic_cast<const SymbolCandidateWord *>(&candidate) ||
+                   dynamic_cast<const SpellCandidateWord *>(&candidate) ||
+                   dynamic_cast<const StrokeCandidateWord *>(&candidate)) {
+            if (state->draftBytes() + candidate.text().toString().size() > 4096) {
+                state->transimeAtCapacity_ = true;
+                return false;
+            }
+            state->transimeSelecting_ = true;
+            try { candidate.select(ic); }
+            catch (...) { state->transimeSelecting_ = false; throw; }
+            state->transimeSelecting_ = false;
+        }
+    }
+    return true;
+}
+
+bool PinyinEngine::transimeCommitParagraphV2(InputContext *ic,
+    PinyinTransimeParagraphSnapshotV2 expected, PinyinTransimeCommitModeV2 mode,
+    std::string translation) {
+    if (!ic || !expected.hasDraft || !ic->hasFocus() ||
+        instance_->inputMethod(ic) != "pinyin" ||
+        ic->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive)) return false;
+    const auto actual = transimeParagraphSnapshotV2(ic, expected.pageIndex);
+    if (!sameParagraph(expected, actual)) return false;
+    if (mode != PinyinTransimeCommitModeV2::Chinese && mode != PinyinTransimeCommitModeV2::Raw &&
+        mode != PinyinTransimeCommitModeV2::Translation) return false;
+    if (mode == PinyinTransimeCommitModeV2::Translation &&
+        (!actual.ready || translation.empty() || !transimeCommentIsSafe(translation))) return false;
+    auto *state = ic->propertyFor(&factory_);
+    std::string output;
+    if (mode == PinyinTransimeCommitModeV2::Raw) output = actual.rawInput;
+    else if (mode == PinyinTransimeCommitModeV2::Translation) output = std::move(translation);
+    else {
+        // Explicit Chinese confirmation alone may learn the native Chinese
+        // contexts. Unknown raw pieces remain visible instead of being lost.
+        if (!paragraphSelectCurrent(ic)) { updateUI(ic); return false; }
+        for (auto &segment : state->segments_) {
+            auto &context = *segment.context;
+            if (!context.empty() && !context.selected()) {
+                context.setCursor(context.size());
+                if (!context.candidates().empty()) context.select(0);
+            }
+            output += context.selectedSentence();
+            output += context.userInput().substr(context.selectedLength());
+            output += segment.literal;
+        }
+        if (output.size() > 4096) return false;
+    }
+    if (output.empty() || output.size() > 4096) return false;
+    // Frontends already block events while dispatching keys; Fcitx's blocker
+    // cannot nest. Clear internal state without emitting callbacks, enqueue the
+    // confirmed output first, then update UI through a weak IC. Client preedit
+    // has always been empty in hold mode. This is not an application receipt.
+    auto weakIC = ic->watch();
+    if (mode == PinyinTransimeCommitModeV2::Chinese) {
+        for (auto &segment : state->segments_) {
+            if (segment.context->selected()) segment.context->learn();
+        }
+    }
+    ic->inputPanel().reset();
+    state->clearParagraph();
+    state->predictWords_.reset();
+    ++state->transimeRevision_;
+    ic->commitString(output);
+    if (auto *live = weakIC.get()) {
+        live->updatePreedit();
+        if ((live = weakIC.get())) live->updateUserInterface(UserInterfaceComponent::InputPanel);
+    }
+    return true;
+}
+
+bool PinyinEngine::transimeCancelParagraphV1(InputContext *ic, uint64_t draftId) {
+    if (!ic) return false;
+    auto *state = ic->propertyFor(&factory_);
+    if (!state->transimeHold_ || draftId != state->transimeDraftId_) return false;
+    doReset(ic);
+    return true;
+}
+
+bool PinyinEngine::transimeSetParagraphCommentV2(InputContext *ic, int pageIndex,
+    PinyinTransimeParagraphSnapshotV2 expected, std::string translation) const {
+    if (!ic || pageIndex < 0 || !transimeCommentIsSafe(translation)) return false;
+    auto *state = ic->propertyFor(&factory_);
+    auto &annotations = state->transimeComments_;
+    std::erase_if(annotations, [](const auto &weak) {
+        auto handle = weak.lock();
+        return !handle || !handle->candidate || !handle->candidate->transimeCommentSnapshot();
+    });
+    if (translation.empty()) {
+        for (auto it = annotations.begin(); it != annotations.end(); ++it) {
+            auto handle = it->lock();
+            auto *candidate = handle ? handle->candidate : nullptr;
+            if (candidate && candidate->engine_ == this && candidate->inputContext_ == ic &&
+                handle->pageIndex == pageIndex && candidate->transimeParagraphCommentSnapshot_ &&
+                sameParagraph(expected, *candidate->transimeParagraphCommentSnapshot_)) {
+                candidate->setTransimeComment(pageIndex, expected.activeCandidate, {});
+                annotations.erase(it);
+                return true;
+            }
+        }
+    }
+    auto actual = transimeParagraphSnapshotV2(ic, pageIndex);
+    if (!actual.ready || !actual.activeCandidate.ready || !sameParagraph(expected, actual)) return false;
+    auto list = ic->inputPanel().candidateList();
+    if (!list || pageIndex >= list->size()) return false;
+    auto *candidate = dynamic_cast<const PinyinCandidateWord *>(&list->candidate(pageIndex));
+    if (!candidate || candidate->engine_ != this || candidate->inputContext_ != ic) return false;
+    if (translation.empty()) return !candidate->transimeCommentSnapshot();
+    const bool registered = std::any_of(annotations.begin(), annotations.end(), [candidate](const auto &weak) {
+        auto handle = weak.lock(); return handle && handle->candidate == candidate;
+    });
+    if (!registered && annotations.size() >= 10) return false;
+    auto *mutableCandidate = const_cast<PinyinCandidateWord *>(candidate);
+    mutableCandidate->setTransimeComment(pageIndex, actual.activeCandidate, std::move(translation));
+    mutableCandidate->transimeParagraphCommentSnapshot_ = actual;
+    if (!registered) annotations.push_back(candidate->transimeCommentHandle());
+    return true;
+}
+
+void PinyinEngine::paragraphSetCursor(InputContext *ic, size_t unicodeCursor) {
+    auto *state = ic->propertyFor(&factory_);
+    for (size_t index = 0; index < state->segments_.size(); ++index) {
+        auto &segment = state->segments_[index];
+        auto &context = *segment.context;
+        const auto rendered = context.preeditWithCursor().first;
+        const size_t nativeChars = utf8::length(rendered);
+        const size_t literalChars = utf8::length(segment.literal);
+        if (unicodeCursor <= nativeChars) {
+            state->activeSegment_ = index;
+            state->literalCursor_ = -1;
+            while (context.selectedLength() && utf8::length(context.selectedSentence()) > unicodeCursor) context.cancel();
+            context.setCursor(context.selectedLength());
+            while (context.cursor() < context.size()) {
+                auto [text, cursor] = context.preeditWithCursor();
+                if (utf8::length(text.begin(), text.begin() + cursor) >= unicodeCursor) break;
+                context.setCursor(context.cursor() + 1);
+            }
+            return;
+        }
+        unicodeCursor -= nativeChars;
+        if (unicodeCursor <= literalChars) {
+            state->activeSegment_ = index;
+            size_t byte = 0;
+            for (size_t count = 0; count < unicodeCursor; ++count) byte = nextUtf8(segment.literal, byte);
+            state->literalCursor_ = byte;
+            return;
+        }
+        unicodeCursor -= literalChars;
+    }
+}
+
+bool PinyinEngine::paragraphInsertLiteral(InputContext *ic, const std::string &literal) {
+    auto *state = ic->propertyFor(&factory_);
+    if (literal.empty() || !transimeCommentIsSafe(literal)) return false;
+    if (state->draftBytes() + literal.size() > 4096) {
+        state->transimeAtCapacity_ = true;
+        return false;
+    }
+    if (state->literalCursor_ < 0) {
+        auto &context = state->context();
+        const size_t cursor = context.cursor();
+        // Split only the unselected raw suffix. Native selected items on the
+        // left stay in the same PinyinContext and keep their cancel stack.
+        std::string suffix;
+        if (cursor < context.size()) suffix = context.userInput().substr(cursor);
+        if (!suffix.empty() && state->segments_.size() >= 32) {
+            state->transimeAtCapacity_ = true;
+            return false;
+        }
+        if (!suffix.empty()) context.erase(cursor, context.size());
+        else if (!paragraphSelectCurrent(ic)) return false;
+        context.setCursor(context.size());
+        if (!context.empty() && !context.selected() && !context.candidates().empty()) context.select(0);
+        if (!suffix.empty()) {
+            PinyinState::Segment next{state->newContext(), {}};
+            next.context->type(suffix);
+            next.literal = std::move(state->segments_[state->activeSegment_].literal);
+            state->segments_.insert(state->segments_.begin() + state->activeSegment_ + 1, std::move(next));
+        }
+        state->literalCursor_ = 0;
+    }
+    auto &segment = state->segments_[state->activeSegment_];
+    segment.literal.insert(static_cast<size_t>(state->literalCursor_), literal);
+    state->literalCursor_ += literal.size();
+    state->transimeAtCapacity_ = false;
+    return true;
+}
+
+void PinyinEngine::updateParagraphModeUI(InputContext *ic) const {
+    auto *state = ic->propertyFor(&factory_);
+    // Do not rebuild the candidate list on a mode toggle: the first literal
+    // must confirm the actual highlighted candidate, including a Down choice.
+    ++state->transimeRevision_;
+    if (state->transimeAtCapacity_) {
+        ic->inputPanel().setAuxUp(Text("段落已达上限，请确认或继续编辑"));
+    } else if (state->transimeEnglish_ && state->transimeControls_.showModeHints) {
+        ic->inputPanel().setAuxUp(Text("英文"));
+    } else {
+        ic->inputPanel().setAuxUp(Text());
+    }
+    ic->updateUserInterface(UserInterfaceComponent::InputPanel);
+}
+
+void PinyinEngine::toggleParagraphMode(InputContext *ic) const {
+    auto *state = ic->propertyFor(&factory_);
+    state->transimeEnglish_ = !state->transimeEnglish_;
+    updateParagraphModeUI(ic);
+}
+
+bool PinyinEngine::handleParagraphModeKey(KeyEvent &event) {
+    auto *ic = event.inputContext();
+    auto *state = ic->propertyFor(&factory_);
+    if (!state->paragraphActive() || !ic->hasFocus() ||
+        ic->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive) ||
+        state->mode_ != PinyinMode::Normal) {
+        state->clearParagraphShift();
+        return false;
+    }
+    // raw/orig states retain Repeat and non-normalized modifiers. key() alone
+    // drops both Repeat and Shift on letters and is insufficient for tap logic.
+    const auto raw = event.rawKey();
+    const auto modifiers = raw.states() | event.origKey().states();
+    const bool repeat = modifiers.test(KeyState::Repeat);
+    const bool otherModifier = modifiers.testAny(KeyStates{
+        KeyState::Ctrl, KeyState::Alt, KeyState::Super, KeyState::Super2,
+        KeyState::Hyper, KeyState::Hyper2, KeyState::Meta, KeyState::Mod5,
+        KeyState::MousePressed});
+    const auto sym = event.key().sym();
+    // Consume the release/repeats of a custom confirmation even when its
+    // modifiers have already been released or confirmation emptied the draft.
+    if (state->transimeConfirmKey_ == sym) {
+        event.filterAndAccept();
+        if (event.isRelease()) state->transimeConfirmKey_ = FcitxKey_None;
+        return true;
+    }
+    if (!event.isRelease() && (event.key().checkKeyList(state->transimeControls_.chineseCommit) ||
+                              event.key().checkKeyList(state->transimeControls_.rawCommit))) {
+        state->transimeShiftTap_ = FcitxKey_None;
+        state->transimeShiftTapTime_ = 0;
+        return handleParagraphKey(event);
+    }
+    // Own the matching release even if Ctrl was released first. Repeated
+    // presses must neither toggle twice nor fall through as a Chinese Space.
+    if (sym == FcitxKey_space && state->transimeModeSpaceDown_) {
+        if (event.isRelease()) state->transimeModeSpaceDown_ = false;
+        state->transimeShiftTap_ = FcitxKey_None;
+        state->transimeShiftTapTime_ = 0;
+        event.filterAndAccept();
+        return true;
+    }
+    if (!event.isRelease() && sym == FcitxKey_space && state->hasDraft() &&
+        event.key().check(FcitxKey_space, KeyState::Ctrl) &&
+        !modifiers.testAny(KeyStates{KeyState::Alt, KeyState::Shift, KeyState::Super,
+            KeyState::Super2, KeyState::Hyper, KeyState::Hyper2, KeyState::Meta,
+            KeyState::Mod5, KeyState::MousePressed})) {
+        state->transimeModeSpaceDown_ = true;
+        state->transimeShiftTap_ = FcitxKey_None;
+        state->transimeShiftTapTime_ = 0;
+        event.filterAndAccept();
+        if (!repeat) toggleParagraphMode(ic);
+        return true;
+    }
+    const uint8_t shift = sym == FcitxKey_Shift_L ? 1 : sym == FcitxKey_Shift_R ? 2 : 0;
+    if (!shift) {
+        // Any other key, including another modifier or its release, cancels
+        // this tap. A following Shift release must not toggle literal mode.
+        state->transimeShiftTap_ = FcitxKey_None;
+        state->transimeShiftTapTime_ = 0;
+        if (!event.isRelease() && event.key().checkKeyList(state->transimeControls_.literalSpace)) {
+            event.filterAndAccept();
+            state->transimeConfirmKey_ = sym;
+            paragraphInsertLiteral(ic, " ");
+            updateUI(ic);
+            return true;
+        }
+        const auto codepoint = Key::keySymToUnicode(sym);
+        if (!event.isRelease() && !otherModifier && codepoint >= 0x21 && codepoint != 0x7f &&
+            (state->transimeEnglish_ || (codepoint >= 'A' && codepoint <= 'Z'))) {
+            // Native optional 2nd/3rd selection keys must not consume literal
+            // digits/punctuation before the regular engine key handler.
+            return handleParagraphKey(event);
+        }
+        return false;
+    }
+
+    if (!event.isRelease()) {
+        const bool singlePress = state->transimeShiftDown_ == 0 &&
+                                 !modifiers.test(KeyState::Shift);
+        state->transimeShiftDown_ |= shift;
+        if (singlePress && !otherModifier && !repeat) {
+            state->transimeShiftTap_ = sym;
+            state->transimeShiftTapTime_ = now(CLOCK_MONOTONIC);
+        } else {
+            state->transimeShiftTap_ = FcitxKey_None;
+            state->transimeShiftTapTime_ = 0;
+        }
+        // Forward the balanced physical modifier to the client, while stopping
+        // Fcitx's later global Shift trigger and native 2nd/3rd selection.
+        event.filter();
+        return true;
+    }
+
+    const bool toggle = state->transimeShiftDown_ == shift &&
+                        state->transimeShiftTap_ == sym && !otherModifier && !repeat &&
+                        instance_->globalConfig().checkModifierOnlyKeyTimeout(
+                            state->transimeShiftTapTime_);
+    state->transimeShiftDown_ &= ~shift;
+    state->transimeShiftTap_ = FcitxKey_None;
+    state->transimeShiftTapTime_ = 0;
+    event.filter();
+    if (toggle) toggleParagraphMode(ic);
+    return true;
+}
+
+bool PinyinEngine::handleParagraphKey(KeyEvent &event) {
+    auto *ic = event.inputContext();
+    auto *state = ic->propertyFor(&factory_);
+    if (event.isRelease() || event.key().isModifier()) return false;
+    if (ic->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive)) {
+        doReset(ic);
+        return false;
+    }
+    const auto &key = event.key();
+    const bool hasDraft = state->hasDraft();
+    if (key.checkKeyList(state->transimeControls_.chineseCommit) ||
+        key.checkKeyList(state->transimeControls_.rawCommit)) {
+        if (!hasDraft) {
+            if (state->transimeEnglish_) {
+                state->transimeEnglish_ = false;
+                updateParagraphModeUI(ic);
+            }
+            return false;
+        }
+        const auto mode = key.checkKeyList(state->transimeControls_.chineseCommit)
+            ? PinyinTransimeCommitModeV2::Chinese : PinyinTransimeCommitModeV2::Raw;
+        auto snapshot = transimeParagraphSnapshotV2(ic, -1);
+        state->transimeConfirmKey_ = key.sym();
+        event.filterAndAccept();
+        transimeCommitParagraphV2(ic, snapshot, mode, {});
+        return true;
+    }
+    // After rebinding confirmation, former bare keys must not reach the
+    // application (Return could send a message while a draft is still held).
+    if (hasDraft && (key.check(FcitxKey_space) || key.check(FcitxKey_Return) ||
+                     key.check(FcitxKey_KP_Enter))) {
+        event.filterAndAccept();
+        state->transimeConfirmKey_ = key.sym();
+        if (key.check(FcitxKey_space)) {
+            paragraphInsertLiteral(ic, " ");
+            updateUI(ic);
+        }
+        return true;
+    }
+    // Other control shortcuts never become literal input or an accidental commit.
+    if ((event.rawKey().states() | event.origKey().states()).testAny(KeyStates{
+            KeyState::Ctrl, KeyState::Alt, KeyState::Super, KeyState::Super2,
+            KeyState::Hyper, KeyState::Hyper2, KeyState::Meta, KeyState::Mod5})) return false;
+    if (key.check(FcitxKey_Escape)) {
+        if (!hasDraft && !state->transimeEnglish_) return false;
+        event.filterAndAccept();
+        doReset(ic);
+        return true;
+    }
+    const auto codepoint = Key::keySymToUnicode(key.sym());
+    const bool letter = (codepoint >= 'a' && codepoint <= 'z') || (codepoint >= 'A' && codepoint <= 'Z');
+    const bool digit = codepoint >= '0' && codepoint <= '9';
+    const bool uppercase = codepoint >= 'A' && codepoint <= 'Z';
+    if ((state->transimeEnglish_ || uppercase) && codepoint >= 0x21 && codepoint != 0x7f) {
+        event.filterAndAccept();
+        if (paragraphInsertLiteral(ic, utf8::UCS4ToUTF8(codepoint))) {
+            state->transimeEnglish_ = true;
+        }
+        updateUI(ic);
+        return true;
+    }
+    if (letter) {
+        event.filterAndAccept();
+        if (state->draftBytes() + 4 > 4096 ||
+            (state->literalCursor_ >= 0 && state->segments_.size() >= 32)) {
+            state->transimeAtCapacity_ = true;
+            updateUI(ic); return true;
+        }
+        if (state->literalCursor_ >= 0) {
+            auto &segment = state->segments_[state->activeSegment_];
+            const auto cursor = static_cast<size_t>(state->literalCursor_);
+            PinyinState::Segment next{state->newContext(), segment.literal.substr(cursor)};
+            next.context->appendContextWords(segment.context->selectedWords());
+            segment.literal.resize(cursor);
+            state->segments_.insert(state->segments_.begin() + state->activeSegment_ + 1, std::move(next));
+            ++state->activeSegment_;
+            state->literalCursor_ = -1;
+        }
+        state->transimeAtCapacity_ = false;
+        state->context().type(utf8::UCS4ToUTF8(codepoint));
+        updateUI(ic); return true;
+    }
+    // Every printable symbol is a paragraph literal; native punctuation,
+    // quickphrase and ASCII page shortcuts cannot commit or take over it.
+    if (codepoint >= 0x21 && codepoint != 0x7f && !digit) {
+        event.filterAndAccept();
+        paragraphInsertLiteral(ic, utf8::UCS4ToUTF8(codepoint));
+        updateUI(ic); return true;
+    }
+    std::shared_future<uint32_t> keyChr = std::async(std::launch::deferred, [codepoint] { return codepoint; }).share();
+    ++state->transimeRevision_;
+    if (handleCandidateList(event, keyChr)) return true;
+    if (digit) {
+        event.filterAndAccept();
+        paragraphInsertLiteral(ic, utf8::UCS4ToUTF8(codepoint));
+        updateUI(ic); return true;
+    }
+    if (!hasDraft) return false;
+    if (key.check(FcitxKey_Home) || key.check(FcitxKey_KP_Home)) {
+        paragraphSetCursor(ic, 0);
+    } else if (key.check(FcitxKey_End) || key.check(FcitxKey_KP_End)) {
+        state->activeSegment_ = state->segments_.size() - 1;
+        auto &segment = state->segments_.back();
+        segment.context->setCursor(segment.context->size());
+        state->literalCursor_ = segment.literal.empty() ? -1 : static_cast<int64_t>(segment.literal.size());
+    } else if (key.check(FcitxKey_Left) || key.check(FcitxKey_KP_Left)) {
+        auto &context = state->context();
+        if (state->literalCursor_ > 0) state->literalCursor_ = previousUtf8(state->segments_[state->activeSegment_].literal, state->literalCursor_);
+        else if (state->literalCursor_ == 0) {
+            state->literalCursor_ = -1;
+            context.setCursor(context.size());
+            if (context.cursor()) {
+                if (context.cursor() == context.selectedLength()) context.cancel();
+                context.setCursor(context.cursor() - 1);
+            } else if (state->activeSegment_) {
+                --state->activeSegment_;
+                auto &previous = state->segments_[state->activeSegment_];
+                previous.context->setCursor(previous.context->size());
+                state->literalCursor_ = previous.literal.empty() ? -1 :
+                    static_cast<int64_t>(previousUtf8(previous.literal, previous.literal.size()));
+            }
+        }
+        else if (context.cursor() > 0) {
+            if (context.cursor() == context.selectedLength()) context.cancel();
+            context.setCursor(context.cursor() - 1);
+        } else if (state->activeSegment_) {
+            --state->activeSegment_;
+            auto &previous = state->segments_[state->activeSegment_];
+            previous.context->setCursor(previous.context->size());
+            state->literalCursor_ = previous.literal.empty() ? -1 : static_cast<int64_t>(previous.literal.size());
+        }
+    } else if (key.check(FcitxKey_Right) || key.check(FcitxKey_KP_Right)) {
+        auto &context = state->context();
+        auto &literal = state->segments_[state->activeSegment_].literal;
+        if (state->literalCursor_ >= 0 && static_cast<size_t>(state->literalCursor_) < literal.size()) state->literalCursor_ = nextUtf8(literal, state->literalCursor_);
+        else if (state->literalCursor_ < 0 && context.cursor() < context.size()) context.setCursor(context.cursor() + 1);
+        else if (state->literalCursor_ < 0 && !literal.empty()) state->literalCursor_ = nextUtf8(literal, 0);
+        else if (state->activeSegment_ + 1 < state->segments_.size()) {
+            ++state->activeSegment_; state->literalCursor_ = -1;
+            state->context().setCursor(0);
+        }
+    } else if (key.check(FcitxKey_BackSpace)) {
+        // Cross a literal boundary and operate on the original previous native
+        // context. Empty segment shells are removed without rebuilding text.
+        while (state->literalCursor_ <= 0 && state->context().empty() && state->activeSegment_) {
+            const auto index = state->activeSegment_;
+            if (state->segments_[index].literal.empty()) state->segments_.erase(state->segments_.begin() + index);
+            --state->activeSegment_;
+            auto &previous = state->segments_[state->activeSegment_];
+            previous.context->setCursor(previous.context->size());
+            state->literalCursor_ = previous.literal.empty() ? -1 : static_cast<int64_t>(previous.literal.size());
+        }
+        auto &context = state->context();
+        auto &literal = state->segments_[state->activeSegment_].literal;
+        if (state->literalCursor_ > 0) {
+            const size_t end = state->literalCursor_;
+            const size_t begin = previousUtf8(literal, end);
+            literal.erase(begin, end - begin);
+            state->literalCursor_ = begin;
+        } else {
+            state->literalCursor_ = -1;
+            if (context.cursor() == 0 && state->activeSegment_) {
+                --state->activeSegment_;
+                auto &previous = state->segments_[state->activeSegment_];
+                previous.context->setCursor(previous.context->size());
+                state->literalCursor_ = previous.literal.size();
+                if (!previous.literal.empty()) {
+                    const auto begin = previousUtf8(previous.literal, previous.literal.size());
+                    previous.literal.resize(begin); state->literalCursor_ = begin;
+                } else if (previous.context->selectedLength() && *config_.useBackSpaceToUnselect) previous.context->cancel();
+                else previous.context->backspace();
+            } else if (context.selectedLength() && *config_.useBackSpaceToUnselect) context.cancel();
+            else context.backspace();
+        }
+    } else if (key.check(FcitxKey_Delete) || key.check(FcitxKey_KP_Delete)) {
+        auto &context = state->context();
+        auto &literal = state->segments_[state->activeSegment_].literal;
+        if (state->literalCursor_ < 0 && context.cursor() < context.size()) context.del();
+        else {
+            if (state->literalCursor_ < 0) state->literalCursor_ = 0;
+            const size_t begin = state->literalCursor_;
+            if (begin < literal.size()) literal.erase(begin, nextUtf8(literal, begin) - begin);
+            else if (state->activeSegment_ + 1 < state->segments_.size()) {
+                ++state->activeSegment_; state->literalCursor_ = -1;
+                state->context().setCursor(0); state->context().del();
+            }
+        }
+    } else {
+        return false;
+    }
+    state->transimeAtCapacity_ = false;
+    event.filterAndAccept();
+    updateUI(ic); return true;
 }
 
