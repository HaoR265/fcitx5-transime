+PinyinTransimeParagraphSnapshotV2
+PinyinEngine::transimeParagraphSnapshotV2(InputContext *ic, int pageIndex) const {
+    PinyinTransimeParagraphSnapshotV2 out;
+    if (!ic) return out;
+    const auto *state = ic->propertyFor(&factory_);
+    out.hold = state->transimeHold_;
+    out.draftId = state->transimeDraftId_;
+    out.revision = state->transimeRevision_;
+    out.activeSegment = state->activeSegment_;
+    out.hasDraft = state->hasDraft();
+    if (!out.hold) { out.reason = "hold-disabled"; return out; }
+    if (!ic->hasFocus() || instance_->inputMethod(ic) != "pinyin") {
+        out.reason = "suspended"; return out;
+    }
+    if (ic->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive)) {
+        out.reason = "sensitive"; return out;
+    }
+    if (state->mode_ != PinyinMode::Normal) { out.reason = "unsupported-mode"; return out; }
+    auto [unused, rendered] = preedit(ic);
+    out.cursorBytes = rendered.cursor();
+    out.ready = out.hasDraft;
+    out.fullySelected = true;
+    const auto list = ic->inputPanel().candidateList();
+    const int requested = pageIndex >= 0 ? pageIndex : (list ? list->cursorIndex() : -1);
+    for (size_t index = 0; index < state->segments_.size(); ++index) {
+        const auto &segment = state->segments_[index];
+        const auto &context = *segment.context;
+        out.rawInput += context.userInput();
+        out.rawInput += segment.literal;
+        if (context.empty()) {
+            // Literal-only paragraph is valid and bounded.
+        } else if (context.selected()) {
+            out.source += context.selectedSentence();
+        } else {
+            out.fullySelected = false;
+            if (index == state->activeSegment_ && state->literalCursor_ < 0) {
+                auto candidate = transimeSnapshotAtImpl(ic, requested, true);
+                if (candidate.ready) {
+                    out.source += candidate.source;
+                    out.activeCandidate = std::move(candidate);
+                    out.pageIndex = requested;
+                } else {
+                    out.ready = false;
+                    out.reason = candidate.reason;
+                    out.source += context.selectedSentence() + context.userInput().substr(context.selectedLength());
+                }
+            } else {
+                out.ready = false;
+                out.reason = "unresolved-other-segment";
+                out.source += context.selectedSentence() + context.userInput().substr(context.selectedLength());
+            }
+        }
+        out.source += segment.literal;
+    }
+    if (pageIndex >= 0 && !out.activeCandidate.ready) {
+        out.ready = false;
+        out.reason = "no-pending-candidate";
+    }
+    if (out.source.size() > 4096 || out.rawInput.size() > 4096) {
+        out.ready = false;
+        out.reason = "capacity";
+    }
+    if (out.ready) out.reason = "ready";
+    else if (!out.hasDraft) out.reason = "empty";
+    return out;
+}
