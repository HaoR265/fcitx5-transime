+PinyinTransimeSnapshotV1
+PinyinEngine::transimeSnapshotAtImpl(InputContext *inputContext, int pageIndex,
+                                   bool allowHold) const {
+    PinyinTransimeSnapshotV1 snapshot;
+    if (!inputContext || !inputContext->hasFocus()) {
+        return snapshot;
+    }
+    if (instance_->inputMethod(inputContext) != "pinyin") {
+        snapshot.reason = "unsupported-input-method";
+        return snapshot;
+    }
+    if (inputContext->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive)) {
+        snapshot.reason = "sensitive";
+        return snapshot;
+    }
+    const auto *state = inputContext->propertyFor(&factory_);
+    snapshot.revision = state->transimeRevision_;
+    if (state->transimeHold_ && !allowHold) {
+        snapshot.reason = "paragraph-hold";
+        return snapshot;
+    }
+    const auto &context = state->context();
+    if (state->mode_ != PinyinMode::Normal || state->predictWords_) {
+        snapshot.reason = "unsupported-mode";
+        return snapshot;
+    }
+    if (context.empty() || context.selected() || context.useShuangpin()) {
+        snapshot.reason = "no-pending-pinyin";
+        return snapshot;
+    }
+    // At the end, candidatesToCursor() aliases candidates(). Reading the latter
+    // avoids even libime's lazy candidate-to-cursor cache update.
+    if (context.cursor() != context.size()) {
+        snapshot.reason = "cursor-not-at-end";
+        return snapshot;
+    }
+    const auto &input = context.userInput();
+    if (input.size() != context.size() ||
+        std::any_of(input.begin(), input.end(), [](unsigned char c) { return c >= 0x80; })) {
+        snapshot.reason = "unsupported-input-encoding";
+        return snapshot;
+    }
+    const auto selectedLength = context.selectedLength();
+    if (selectedLength >= input.size()) {
+        snapshot.reason = "no-unselected-input";
+        return snapshot;
+    }
+    const auto candidateList = inputContext->inputPanel().candidateList();
+    if (!candidateList || pageIndex < 0 || pageIndex >= candidateList->size()) {
+        snapshot.reason = "invalid-page-index";
+        return snapshot;
+    }
+    const auto &word = candidateList->candidate(pageIndex);
+    // This cast stays inside the engine that owns the candidate types. Clients
+    // use only the public value snapshot and never access pinyinState.
+    const auto *candidate = dynamic_cast<const PinyinCandidateWord *>(&word);
+    if (!candidate || candidate->engine_ != this ||
+        candidate->inputContext_ != inputContext) {
+        snapshot.reason = "unsupported-candidate";
+        return snapshot;
+    }
+    if (state->paragraphActive() &&
+        (candidate->transimeContextIdentity_ != &context ||
+         candidate->transimeCandidateEpoch_ != state->transimeCandidateEpoch_)) {
+        snapshot.reason = "stale-candidate-context";
+        return snapshot;
+    }
+    const auto index = candidate->candidateIndex();
+    const auto &candidates = context.candidates();
+    if (index >= candidates.size() || index > static_cast<size_t>(std::numeric_limits<int>::max())) {
+        snapshot.reason = "stale-candidate";
+        return snapshot;
+    }
+    const auto &result = candidates[index];
+    const auto remaining = input.size() - selectedLength;
+    if (result.sentence().empty() || candidate->selectLength() != remaining ||
+        result.sentence().back()->to()->index() != remaining) {
+        snapshot.reason = "partial-candidate";
+        return snapshot;
+    }
+    const auto candidateText = result.toString();
+    if (candidateText.empty() || candidateText != candidate->text().toString() ||
+        getEncodedPinyin(result).empty()) {
+        snapshot.reason = "stale-or-non-pinyin-candidate";
+        return snapshot;
+    }
+    // Do not claim a custom selected prefix has ordinary pinyin provenance.
+    const auto selectedWords = context.selectedWordsWithPinyin();
+    if (std::any_of(selectedWords.begin(), selectedWords.end(), [](const auto &word) {
+            return !word.first.empty() && word.second.empty();
+        })) {
+        snapshot.reason = "unsupported-selected-prefix";
+        return snapshot;
+    }
+    snapshot.selectedText = context.selectedSentence();
+    snapshot.candidateText = candidateText;
+    snapshot.source = snapshot.selectedText + snapshot.candidateText;
+    snapshot.inputBytes = input.size();
+    snapshot.selectedInputBytes = selectedLength;
+    snapshot.candidateInputEnd = selectedLength + candidate->selectLength();
+    snapshot.cursorBytes = context.cursor();
+    snapshot.candidateIndex = static_cast<int>(index);
+    snapshot.ready = true;
+    snapshot.reason = "ready";
+    return snapshot;
+}
