+bool PinyinEngine::transimeSetControlsV1(InputContext *ic, PinyinTransimeControlsV1 controls) {
+    if (!ic || controls.chineseCommit.empty() || controls.rawCommit.empty() ||
+        controls.literalSpace.empty() || !transimeValidControlKeys({
+            controls.chineseCommit, controls.rawCommit, controls.literalSpace})) return false;
+    auto *state = ic->propertyFor(&factory_);
+    const bool hintsChanged = state->transimeControls_.showModeHints != controls.showModeHints;
+    controls.chineseCommit = transimeNormalizeControlKeys(std::move(controls.chineseCommit));
+    controls.rawCommit = transimeNormalizeControlKeys(std::move(controls.rawCommit));
+    controls.literalSpace = transimeNormalizeControlKeys(std::move(controls.literalSpace));
+    state->transimeControls_ = std::move(controls);
+    if (hintsChanged && state->paragraphActive() && ic->hasFocus()) updateParagraphModeUI(ic);
+    return true;
+}
+
+int PinyinEngine::transimeSetHoldV1(InputContext *ic, bool enabled) {
+    if (!ic) return 3;
+    auto *state = ic->propertyFor(&factory_);
+    if (!enabled) {
+        if (state->transimeHold_ && state->hasDraft()) {
+            state->transimeDisablePending_ = true;
+            return 2;
+        }
+        const bool hadEnglish = state->transimeEnglish_;
+        state->transimeHold_ = false;
+        state->transimeDisablePending_ = false;
+        state->transimeEnglish_ = false;
+        state->clearParagraphShift();
+        if (hadEnglish && ic->hasFocus()) updateParagraphModeUI(ic);
+        return 0;
+    }
+    if (!ic->hasFocus()) return state->transimeHold_ ? 1 : 3;
+    if (instance_->inputMethod(ic) != "pinyin" ||
+        ic->capabilityFlags().testAny(CapabilityFlag::PasswordOrSensitive) ||
+        state->mode_ != PinyinMode::Normal || state->context().useShuangpin() ||
+        state->draftBytes() > 4096) return 3;
+    state->transimeDisablePending_ = false;
+    state->transimeSuspended_ = false;
+    if (!state->transimeHold_) {
+        state->transimeHold_ = true;
+        state->predictWords_.reset();
+        ++state->transimeRevision_;
+        updateUI(ic);
+    }
+    return 1;
+}
