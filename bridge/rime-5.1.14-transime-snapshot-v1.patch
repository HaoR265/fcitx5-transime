     if (auto session = this->session()) {
         engine_->api()->clear_composition(session);
     }
 }
 
+RimeTransimeSnapshotV1 RimeState::transimeSnapshot() {
+    RimeTransimeSnapshotV1 snapshot;
+    auto *api = engine_->api();
+    auto id = session(false);
+    if (!id || !api->find_session(id) || api->get_option(id, RIME_ASCII_MODE)) {
+        return snapshot;
+    }
+    RIME_STRUCT(RimeContext, context);
+    if (!api->get_context(id, &context)) {
+        return snapshot;
+    }
+    const char *input = api->get_input(id);
+    const char *preview = context.commit_text_preview;
+    if (input && preview && context.composition.length > 0 &&
+        context.menu.num_candidates > 0 &&
+        context.menu.highlighted_candidate_index >= 0 &&
+        context.menu.highlighted_candidate_index < context.menu.num_candidates) {
+        snapshot.rawInput = input;
+        snapshot.source = preview;
+        snapshot.inputBytes = snapshot.rawInput.size();
+        snapshot.cursorBytes = api->get_caret_pos(id);
+        snapshot.candidateIndex = context.menu.highlighted_candidate_index;
+        snapshot.revision = transimeRevision_;
+        // A mixed/unresolved Latin preview is not a complete Chinese source.
+        const bool hasLatin = std::any_of(snapshot.source.begin(), snapshot.source.end(),
+            [](unsigned char ch) { return (ch >= 'a' && ch <= 'z') ||
+                                          (ch >= 'A' && ch <= 'Z'); });
+        const bool hasControl = std::any_of(snapshot.source.begin(), snapshot.source.end(),
+            [](unsigned char ch) { return ch < 0x20 || ch == 0x7f; });
+        snapshot.ready = !snapshot.rawInput.empty() && !snapshot.source.empty() &&
+            snapshot.inputBytes <= 4096 && snapshot.source.size() <= 4096 &&
+            utf8::lengthValidated(snapshot.source) != utf8::INVALID_LENGTH &&
+            !hasLatin && !hasControl && snapshot.source != snapshot.rawInput &&
+            snapshot.cursorBytes == snapshot.inputBytes &&
+            context.composition.cursor_pos == context.composition.length &&
+            context.composition.sel_start == 0 &&
+            context.composition.sel_end == context.composition.length;
+    }
+    api->free_context(&context);
+    return snapshot;
+}
